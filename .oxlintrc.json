{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "import"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["dist", "coverage"],
  "overrides": [
    {
      "files": ["**/*.test.ts", "vitest.setup.js"],
      "plugins": ["vitest"],
      "env": {
        "node": true
      },
      "rules": {
        "vitest/require-mock-type-parameters": "off"
      }
    },
    {
      "files": ["examples/**/*.js"],
      "env": {
        "node": true
      }
    }
  ]
}
